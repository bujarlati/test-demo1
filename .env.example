PORT=8787
# ECS + Nginx 等单机部署建议只监听回环地址；容器或托管平台按需使用 0.0.0.0。
HOST=127.0.0.1
# 线上主库。设置后账号、会话、故事、章节与 Revision 使用 PostgreSQL；不设置则保留 JSON 兼容模式。
DATABASE_URL=
# 默认 true，启动时只执行前向、幂等 migration；若部署流水线单独执行 pnpm db:migrate 可设为 false。
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_SIZE=10
# PostgreSQL 模式只在内存保留最近使用的少量故事聚合。
XUMO_STORY_CACHE_SIZE=32
# 仅纯演示站允许生产环境退回 memory/临时 JSON；真实用户环境不要开启。
XUMO_ALLOW_EPHEMERAL_PRODUCTION=false
# 生产环境可写数据目录；无持久卷的平台可指向 /tmp（实例重启后数据会重置）。
XUMO_DATA_DIRECTORY=
# 无可写文件系统的平台设为 memory；数据只在当前运行实例中保留。
XUMO_STORAGE_MODE=
# 已构建前端静态文件所在目录；Sites Worker 使用 /bundle。
XUMO_STATIC_DIRECTORY=
# 生产环境请提供 32 字节 Base64 或 64 位十六进制密钥。
APP_ENCRYPTION_KEY=
# 新开篇启用上下文语义门禁；默认关闭，开启时必须同时配置 DATABASE_URL 和稳定的 APP_ENCRYPTION_KEY。
CONTEXTUAL_NARRATION_REVIEW_ENABLED=false
# 只影响新产生的语义判断；已暂停案例继续使用其 checkpoint 中记录的实际阈值。
NARRATION_REVIEW_CONFIDENCE_THRESHOLD=0.85
# SaaS 默认禁止内网、localhost 与 HTTP 模型地址。
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
# 调试时记录发送给模型的完整提示与原始回答；开发环境默认开启，生产环境默认关闭。
# 日志可能包含故事正文；需要临时关闭时显式设置 false。
AI_TRACE_ENABLED=
# 留空时默认写入 server/data/ai-trace.jsonl。
AI_TRACE_FILE=
