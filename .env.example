PORT=8787
# 生产环境可写数据目录；无持久卷的平台可指向 /tmp（实例重启后数据会重置）。
XUMO_DATA_DIRECTORY=
# 无可写文件系统的平台设为 memory；数据只在当前运行实例中保留。
XUMO_STORAGE_MODE=
# 已构建前端静态文件所在目录；Sites Worker 使用 /bundle。
XUMO_STATIC_DIRECTORY=
# 生产环境请提供 32 字节 Base64 或 64 位十六进制密钥。
APP_ENCRYPTION_KEY=
# SaaS 默认禁止内网、localhost 与 HTTP 模型地址。
ALLOW_PRIVATE_MODEL_ENDPOINTS=false
# 调试时记录发送给模型的完整提示与原始回答；开发环境默认开启，生产环境默认关闭。
# 日志可能包含故事正文；需要临时关闭时显式设置 false。
AI_TRACE_ENABLED=
# 留空时默认写入 server/data/ai-trace.jsonl。
AI_TRACE_FILE=
